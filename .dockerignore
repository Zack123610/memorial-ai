# Build context for server/Dockerfile (context is the repo root).
**/node_modules
**/.venv
**/__pycache__
**/.ruff_cache
**/dist
**/build
**/*.tsbuildinfo

.git
.gitignore
.husky
logs
docs
data
assets
scripts

# The client is deployed to Cloudflare Pages, not baked into the API image.
# Its package.json stays in context because npm resolves the workspace set
# from the root package.json and errors on a missing member.
client
!client/package.json

tts-service
video-service

**/.env
**/.env.local
**/.env.*.local
!**/.env.example

**/storage
**/uploads
**/.DS_Store
*.md
