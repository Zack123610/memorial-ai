TTS_HOST=127.0.0.1
TTS_PORT=8200

# Aliyun DashScope — reference audio → cloned voice → synthesized speech.
# Same key as video-service; use the endpoint matching the key's region
# (https://dashscope-intl.aliyuncs.com for Singapore).
DASHSCOPE_API_KEY=
TTS_DASHSCOPE_BASE=https://dashscope.aliyuncs.com

# Cloning model, and the TTS model the cloned voice is bound to. These must
# stay in sync: synthesis fails if the voice was enrolled for another model.
TTS_ENROLLMENT_MODEL=qwen-voice-enrollment
TTS_DASHSCOPE_MODEL=qwen3-tts-vc-2026-01-22
# Keyword embedded in generated voice names (letters/digits/underscore, max 16 chars)
TTS_VOICE_PREFIX=memorial

# Reference audio limits. DashScope wants 10-20s of clean mono speech (60s max),
# and the base64-encoded payload must stay under 10MB.
TTS_MIN_REF_SECONDS=3
TTS_MAX_REF_SECONDS=60
TTS_MAX_REF_BYTES=7340032
# Send the transcript so DashScope can check it matches the audio. Set false if
# valid samples get rejected as mismatched.
TTS_SEND_REF_TEXT=true

# Enrollments are cached so the same reference sample is only cloned once
TTS_VOICE_CACHE_TTL=86400
TTS_VOICE_CACHE_SIZE=128
# Delete the voices this process created on shutdown (DashScope caps voice count)
TTS_DELETE_VOICES_ON_SHUTDOWN=true

TTS_REQUEST_TIMEOUT=120
