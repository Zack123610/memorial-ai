TTS_HOST=127.0.0.1
TTS_PORT=8200

# Aliyun DashScope — reference audio → cloned voice → synthesized speech.
# Same key as video-service. This project uses 华北2/Beijing (cn-beijing),
# where the models are cheapest; a key issued for another region fails with
# InvalidApiKey. Model Studio also issues a faster workspace-specific domain:
#   Beijing:   https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com
#   Singapore: https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com
DASHSCOPE_API_KEY=
TTS_DASHSCOPE_BASE=https://dashscope.aliyuncs.com

# Cloning service and the TTS model the cloned voice is bound to. These must
# stay in sync: synthesis fails if the voice was enrolled for another model.
# (qwen3-tts-vc-* was retired on 2026-10-10; cloning now goes through
# voice-enrollment + qwen-audio-3.0-tts-flash.)
TTS_ENROLLMENT_MODEL=voice-enrollment
TTS_DASHSCOPE_MODEL=qwen-audio-3.0-tts-flash
# Keyword embedded in generated voice IDs (letters/digits/underscore)
TTS_VOICE_PREFIX=memorial

# Reference audio limits. Qwen-Audio-TTS requires at least 5s of continuous
# clear speech, recommends 10-20s, caps at 60s, and the payload must stay
# under 10MB (base64 adds ~33%, hence the 7MB raw cap).
TTS_MIN_REF_SECONDS=5
TTS_MAX_REF_SECONDS=60
TTS_MAX_REF_BYTES=7340032

# Enrollments are cached so the same reference sample is only cloned once
TTS_VOICE_CACHE_TTL=86400
TTS_VOICE_CACHE_SIZE=128
# Delete the voices this process created on shutdown (DashScope caps voice count)
TTS_DELETE_VOICES_ON_SHUTDOWN=true

# Enrollment with voice-enrollment can take ~2 minutes; give it room.
TTS_REQUEST_TIMEOUT=240
