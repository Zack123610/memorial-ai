# Server
PORT=3001
NODE_ENV=development

# TTS service (FastAPI / DashScope Qwen3-TTS voice cloning)
# This service has its own .env (DashScope key) — see tts-service/.env.example
TTS_SERVICE_URL=http://localhost:8200

# Video service (FastAPI / DashScope Wan2.7 i2v)
# This service has its own .env (DashScope key, S3 config) — see video-service/.env.example
VIDEO_SERVICE_URL=http://localhost:8300

# Video quality knobs forwarded by the Express pipeline
VIDEO_RESOLUTION=720P
VIDEO_DURATION=5
VIDEO_DURATION_MIN=5
VIDEO_DURATION_MAX=10
VIDEO_PROMPT_EXTEND=true
VIDEO_WATERMARK=false

# Input limits (client mirrors these defaults)
MAX_TEXT_CHARS=800
MAX_REF_TEXT_CHARS=500
MIN_AUDIO_SECONDS=3
MAX_AUDIO_SECONDS=60

# Downstream HTTP behaviour
TTS_TIMEOUT_MS=120000
VIDEO_TIMEOUT_MS=60000
VIDEO_POLL_INTERVAL_MS=5000
VIDEO_WAIT_TIMEOUT_MS=900000
HEALTH_TIMEOUT_MS=3000
DOWNSTREAM_RETRIES=1

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# Storage
STORAGE_DIR=./storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50

# Client
VITE_API_BASE=http://localhost:3001
VITE_SOCKET_URL=http://localhost:3001
