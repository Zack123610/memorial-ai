# Server
PORT=3001
NODE_ENV=development

# --- Deployment (docker-compose.prod.yml reads these from this file) ---
# Token for the Cloudflare Tunnel that fronts the API. Create the tunnel under
# Zero Trust > Networking > Tunnels and route your API hostname to
# http://server:3001.
# TUNNEL_TOKEN=
# Optional Tailscale subnet router for admin access to the NAS itself.
# Enable with: docker compose -f docker-compose.prod.yml --profile tailscale up -d
# TS_AUTHKEY=
# TS_HOSTNAME=memorial-nas
# TS_ROUTES=192.168.1.0/24

# TTS service (FastAPI / DashScope Qwen3-TTS voice cloning)
# This service has its own .env (DashScope key) — see tts-service/.env.example
TTS_SERVICE_URL=http://localhost:8200

# Video service (FastAPI / DashScope Wan i2v)
# This service has its own .env (DashScope key, S3 config) — see video-service/.env.example
VIDEO_SERVICE_URL=http://localhost:8300

# Video quality knobs forwarded by the Express pipeline.
# The video is as long as the cloned speech, rounded up into the window below.
# VIDEO_DURATION_MAX is capped at 15 regardless — Wan i2v rejects anything
# longer. A farewell that would take more than VIDEO_DURATION_MAX to speak is
# rejected at POST /api/jobs, so the video always finishes the sentence.
VIDEO_RESOLUTION=720P
VIDEO_DURATION=5
VIDEO_DURATION_MIN=5
VIDEO_DURATION_MAX=15
VIDEO_PROMPT_EXTEND=true
VIDEO_WATERMARK=false

# Input limits (client mirrors these defaults)
MAX_TEXT_CHARS=800
MAX_REF_TEXT_CHARS=500
MIN_AUDIO_SECONDS=3
MAX_AUDIO_SECONDS=60

# Downstream HTTP behaviour
TTS_TIMEOUT_MS=120000
VIDEO_TIMEOUT_MS=60000
VIDEO_POLL_INTERVAL_MS=5000
VIDEO_WAIT_TIMEOUT_MS=900000
HEALTH_TIMEOUT_MS=3000
DOWNSTREAM_RETRIES=1

# Redis — job state lives here, so jobs survive a restart
REDIS_HOST=localhost
REDIS_PORT=6379
# How long a job stays readable. Keep in sync with video-service's
# S3_OUTPUT_URL_TTL so the job record and its video URL expire together.
JOB_TTL_SECONDS=604800

# Browser origins allowed to call this API. Empty allows any origin, which is
# only acceptable in development — in production set your Pages hostname.
# CORS_ORIGINS=https://memorial-ai.pages.dev,https://app.example.com

# Cloudflare Access (Zero Trust) in front of the tunnel. Find the team domain
# under Zero Trust > Settings > Custom Pages, and the AUD tag on the Access
# application's overview page. Set CF_ACCESS_REQUIRED=true in production to
# reject any request without a valid Access token.
# CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CF_ACCESS_AUD=
CF_ACCESS_REQUIRED=false

# Generation quotas. Every accepted job spends DashScope credit (roughly
# US$0.60 for a 15s 720P video plus voice cloning), so QUOTA_GLOBAL_DAY is a
# hard ceiling on daily spend. Set any of these to 0 to disable that window.
QUOTA_USER_HOUR=5
QUOTA_USER_DAY=10
QUOTA_GLOBAL_DAY=25

# Storage
STORAGE_DIR=./storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50

# Client (build-time; set these in the Cloudflare Pages dashboard for deploys)
# Leave empty for local development — Vite proxies /api and /socket.io to the
# server, which keeps requests same-origin. In production point them at the
# tunnel hostname, e.g. https://api.example.com.
VITE_API_BASE=
VITE_SOCKET_URL=
